# Database Configuration (Docker)
# Use 'postgres' as host when running inside Docker containers
# Use 'localhost' when running scripts from host machine
# Inside Docker: PostgreSQL runs on port 5432
# From Host: PostgreSQL is accessible on port 5432
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=clan_identity
POSTGRES_PORT=5432

# Admin Service Database (External Repository: clan-platform-domain-be)
# Connect to admin_service database running on host machine
# Use host.docker.internal to access host machine from Docker container
ADMIN_POSTGRES_HOST=host.docker.internal
ADMIN_POSTGRES_PORT=5432
ADMIN_POSTGRES_USER=postgres
ADMIN_POSTGRES_PASSWORD=root
ADMIN_DB=clan_platform

# Redis Configuration (Docker)
# Use 'redis' as host when running inside Docker containers
# Inside Docker: Redis runs on port 6379
# From Host: Redis is accessible on port 6380
REDIS_HOST=redis
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# Application Configuration
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ENVIRONMENT=development

# Service Ports
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
SESSION_SERVICE_PORT=8003
RBAC_SERVICE_PORT=8004
OAUTH_SERVICE_PORT=8005

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================
# PAYLOAD ENCRYPTION/DECRYPTION
# ==============================================
# Disabled locally — no encryption overhead during development
PAYLOAD_ENCRYPTION_ENABLED=false
ENCRYPTION_REQUIRE_ENCRYPTED_REQUESTS=false

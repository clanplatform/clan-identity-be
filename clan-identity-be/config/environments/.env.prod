# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================

# Environment
ENVIRONMENT=production
DEBUG=false

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_HOST=your-production-db-host.com
POSTGRES_PORT=5432
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=<STRONG_PASSWORD_HERE>
POSTGRES_DB=clan_identity

# Admin Database (for user lookup)
ADMIN_POSTGRES_HOST=your-admin-db-host.com
ADMIN_POSTGRES_PORT=5432
ADMIN_POSTGRES_USER=admin_prod_user
ADMIN_POSTGRES_PASSWORD=<STRONG_PASSWORD_HERE>
ADMIN_DB=clan_platform

# ==============================================
# JWT & AUTHENTICATION
# ==============================================
JWT_SECRET_KEY=<GENERATE_STRONG_256_BIT_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal API Key for service-to-service communication
INTERNAL_API_KEY=<GENERATE_STRONG_API_KEY>

# ==============================================
# PAYLOAD ENCRYPTION/DECRYPTION (NEW)
# ==============================================
# Enable/disable request-response encryption
PAYLOAD_ENCRYPTION_ENABLED=true

# AES-256-GCM encryption key (32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
PAYLOAD_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>

# Optional: Separate keys for different services (key rotation support)
CLAN_IDENTITY_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>
USER_SERVICE_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>
OAUTH_SERVICE_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>
RBAC_SERVICE_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>
SESSION_SERVICE_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>

# Encryption algorithm (AES-GCM recommended for authenticated encryption)
ENCRYPTION_ALGORITHM=AES-256-GCM

# Exclude paths from encryption (comma-separated, for health checks, docs, etc.)
ENCRYPTION_EXCLUDE_PATHS=/health,/,/api/v1/docs,/api/v1/openapi.json,/api/v1/redoc

# Reject non-encrypted requests on all sensitive endpoints
ENCRYPTION_REQUIRE_ENCRYPTED_REQUESTS=true

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=<REDIS_PASSWORD_HERE>
REDIS_ENABLED=true

# ==============================================
# CORS SETTINGS
# ==============================================
CORS_ORIGINS=https://your-production-domain.com,https://app.your-domain.com

# ==============================================
# EMAIL/SMTP SETTINGS
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=<SMTP_APP_PASSWORD>
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Your App Name
SMTP_TLS=true

# OTP Settings
OTP_DEV_MODE=false
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# ==============================================
# RATE LIMITING
# ==============================================
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ==============================================
# KAFKA CONFIGURATION
# ==============================================
KAFKA_BOOTSTRAP_SERVERS=your-kafka-broker:9092
KAFKA_CONSUMER_GROUP=auth-service
KAFKA_ENABLED=true

# ==============================================
# SECURITY HEADERS
# ==============================================
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=<YOUR_SENTRY_DSN_IF_USING>

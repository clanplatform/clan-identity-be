# ==============================================
# PRODUCTION ENVIRONMENT — RENDER DEPLOY
# ==============================================
# This file is a reference only. Actual values are set in the Render dashboard.
# Variables marked [RENDER-AUTO] are injected by Render from linked databases/services.
# Variables marked [SET IN DASHBOARD] must be added manually in the Render dashboard.

ENVIRONMENT=production
DEBUG=false

# ==============================================
# DATABASE — clan_identity (Render Managed Postgres)
# ==============================================
POSTGRES_DB=clan_identity
POSTGRES_HOST=<RENDER-AUTO>            # fromDatabase: clan-identity-db-prod → host
POSTGRES_PORT=<RENDER-AUTO>            # fromDatabase: clan-identity-db-prod → port
POSTGRES_USER=<RENDER-AUTO>            # fromDatabase: clan-identity-db-prod → user
POSTGRES_PASSWORD=<RENDER-AUTO>        # fromDatabase: clan-identity-db-prod → password

# Admin/Platform Database (clan-platform-domain-be — external service)
# [SET IN DASHBOARD]
ADMIN_DB=clan_platform
ADMIN_POSTGRES_HOST=<your-admin-db-host>
ADMIN_POSTGRES_PORT=5432
ADMIN_POSTGRES_USER=<your-admin-db-user>
ADMIN_POSTGRES_PASSWORD=<your-admin-db-password>

# ==============================================
# REDIS — Render Managed Redis
# ==============================================
REDIS_HOST=<RENDER-AUTO>               # fromService: clan-identity-redis-prod → host
REDIS_PORT=<RENDER-AUTO>               # fromService: clan-identity-redis-prod → port
REDIS_DB=1
REDIS_ENABLED=true
# [SET IN DASHBOARD]
REDIS_PASSWORD=<your-render-redis-password>

# ==============================================
# JWT & AUTHENTICATION
# ==============================================
# [SET IN DASHBOARD] — generate with: openssl rand -hex 32
JWT_SECRET_KEY=<GENERATE_STRONG_256_BIT_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# [SET IN DASHBOARD]
INTERNAL_API_KEY=<GENERATE_STRONG_API_KEY>

# ==============================================
# CORS
# ==============================================
# [SET IN DASHBOARD]
CORS_ORIGINS=https://your-frontend-domain.com

# ==============================================
# PAYLOAD ENCRYPTION
# ==============================================
PAYLOAD_ENCRYPTION_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_EXCLUDE_PATHS=/health,/,/api/v1/docs,/api/v1/openapi.json,/api/v1/redoc
ENCRYPTION_REQUIRE_ENCRYPTED_REQUESTS=true
# [SET IN DASHBOARD] — generate with: openssl rand -base64 32
PAYLOAD_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>
AUTH_SERVICE_ENCRYPTION_KEY=<GENERATE_AES_256_KEY_BASE64>

# ==============================================
# KAFKA (disable if not provisioned on Render)
# ==============================================
KAFKA_ENABLED=false

# ==============================================
# EMAIL / OTP
# ==============================================
OTP_DEV_MODE=false
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
# [SET IN DASHBOARD]
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@domain.com>
SMTP_PASSWORD=<SMTP_APP_PASSWORD>
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=ClanPlatform

# ==============================================
# RATE LIMITING
# ==============================================
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
